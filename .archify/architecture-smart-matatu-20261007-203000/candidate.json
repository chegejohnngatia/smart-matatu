  "cards": [
    {
      "dot": "cyan",
      "title": "Core Features",
      "items": [
        "Matatu registration & route assignment",
        "Route stages with GPS coordinates",
        "QR-code passenger booking",
        "Conductor stop notification dashboard",
        "Real-time vehicle tracking simulation",
        "ETA calculation via Haversine formula"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data Model",
      "items": [
        "matatus: id, registration_number, route_name",
        "stages: id, route_name, name, lat/lng, sequence",
        "passenger_destinations: id, matatu_id, token, stage_id, status",
        "matatu_locations: matatu_id, lat/lng, current_stage, speed"
      ]
    },
    {
      "dot": "violet",
      "title": "Key Routes",
      "items": [
        "GET/POST /add-matatu — Register vehicle",
        "GET/POST /add-stage — Define route stops",
        "GET /generate-qr/<id> — Passenger QR code",
        "GET/POST /passenger/<id> — Book destination",
        "GET /conductor/<id> — Ordered passenger list",
        "POST /notify-passenger/<id> — Mark notified",
        "GET /vehicle-status/<id> — ETA JSON API",
        "GET/POST /move-matatu/<id> — Simulate movement"
      ]
    },
    {
      "dot": "amber",
      "title": "Tech Stack",
      "items": [
        "Python 3 + Flask 3.1",
        "SQLite (embedded)",
        "Jinja2 templates",
        "qrcode + Pillow for QR images",
        "Haversine distance (math)"
      ]
    }
  ]
